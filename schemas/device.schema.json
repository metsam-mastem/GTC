{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtc.example/schemas/device.schema.json",
  "title": "GTC Device Record",
  "type": "object",
  "required": ["schema_version", "gtc_id", "entity_type", "canonical_name", "manufacturer", "taxonomy_ids", "identity", "lifecycle", "hardware", "software", "claims", "source_ids", "completeness"],
  "properties": {
    "schema_version": {"type": "string"},
    "gtc_id": {"type": "string", "pattern": "^GTC-[A-Z0-9-]+$"},
    "entity_type": {"enum": ["device_model", "device_variant"]},
    "canonical_name": {"type": "string", "minLength": 2},
    "manufacturer": {"type": "object", "required": ["manufacturer_id", "name"], "properties": {"manufacturer_id": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": true},
    "product_family": {"type": ["object", "null"]},
    "taxonomy_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "identity": {"type": "object", "required": ["model_codes", "codenames", "aliases"], "properties": {"model_codes": {"type": "array", "items": {"type": "string"}}, "codenames": {"type": "array", "items": {"type": "string"}}, "aliases": {"type": "array", "items": {"type": "string"}}, "regulatory_ids": {"type": "array", "items": {"type": "string"}}, "regional_skus": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "lifecycle": {"type": "object", "required": ["release_year", "release_date", "events", "status"], "properties": {"release_year": {"type": ["integer", "null"]}, "release_date": {"type": ["string", "null"], "format": "date"}, "announcement_date": {"type": ["string", "null"], "format": "date"}, "discontinued_date": {"type": ["string", "null"], "format": "date"}, "status": {"type": "string"}, "events": {"type": "array", "items": {"type": "object", "required": ["event_type", "date", "description"], "properties": {"event_type": {"type": "string"}, "date": {"type": "string"}, "description": {"type": "string"}, "source_claim_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}}, "additionalProperties": true},
    "markets": {"type": "array", "items": {"type": "string"}},
    "physical": {"type": "object"},
    "hardware": {"type": "object"},
    "software": {"type": "object"},
    "relationships": {"type": "array", "items": {"type": "object", "required": ["relation_type", "target_gtc_id"], "properties": {"relation_type": {"type": "string"}, "target_gtc_id": {"type": "string"}}, "additionalProperties": true}},
    "claims": {"type": "array", "items": {"$ref": "claim.schema.json"}, "minItems": 1},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "completeness": {"type": "object", "required": ["state", "missing_sections"], "properties": {"state": {"enum": ["NOT_STARTED", "IDENTIFIED", "BASIC_PROFILE", "SPECIFICATIONS_SOURCED", "HARDWARE_DOCUMENTED", "SOFTWARE_DOCUMENTED", "ENGINEERING_EVIDENCE", "REVIEWED", "CONFLICTED", "BLOCKED"]}, "missing_sections": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
